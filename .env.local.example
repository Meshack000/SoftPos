# Copy this file to .env.local and fill in your own values.
# Never share .env.local or commit it to GitHub.
PAYSTACK_SECRET_KEY=sk_test_your_key_here
ADMIN_PASSCODE=choose-something-only-you-know
PLATFORM_FEE_PERCENT=0
PAYSTACK_FEE_BEARER=account

# Supabase: Project URL and the SECRET key (starts with sb_secret_).
# The secret key must stay on the server. Never put NEXT_PUBLIC_ in front of it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here